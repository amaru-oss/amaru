{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/events/EventList.json",
  "title": "EventList",
  "description": "Persisted events of one Project or Execution, oldest first. `nextCursor` is the `seq` to resume from. When the requested cursor cannot be served the list carries `resync` and no events (no partial history alongside it).",
  "type": "object",
  "required": [
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "Event.json"
      }
    },
    "nextCursor": {
      "type": "integer",
      "minimum": 0
    },
    "resync": {
      "$ref": "ResyncRequired.json"
    }
  },
  "if": {
    "required": [
      "resync"
    ]
  },
  "then": {
    "properties": {
      "events": {
        "maxItems": 0
      }
    },
    "not": {
      "required": [
        "nextCursor"
      ]
    }
  }
}
